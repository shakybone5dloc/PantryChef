@page "/notifications"
@attribute [Authorize]
@implements IDisposable
@inject NotificationState State

<PageTitle>Notifications · PantryChef</PageTitle>

<h1 class="mb-4">Notifications</h1>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}

@if (State.Items.Count == 0)
{
    <p>No notifications yet. You'll get a daily heads-up here when pantry items are about to expire.</p>
}
else
{
    <ul class="list-group">
        @foreach (var n in State.Items)
        {
            <li class="list-group-item d-flex justify-content-between align-items-start @(n.IsRead ? "text-muted" : "")">
                <div>
                    <div class="@(n.IsRead ? "" : "fw-semibold")">@n.Message</div>
                    <small>@n.ForDate.ToString("ddd, MMM d")</small>
                </div>
                @if (!n.IsRead)
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => MarkReadAsync(n.Id)">Mark read</button>
                }
            </li>
        }
    </ul>
}

@code {
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnChanged;
        try { await State.RefreshAsync(); }
        catch (HttpRequestException) { error = "Can't reach the API. Is it running?"; }
    }

    private async Task MarkReadAsync(int id)
    {
        try { await State.MarkReadAsync(id); }
        catch (HttpRequestException) { error = "Couldn't update that notification. Try again."; }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => State.Changed -= OnChanged;
}