<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <!-- [ValidationType] is experimental in .NET 10. We opt in deliberately; the
	        integration test Add_InvalidRequest_Returns400WithFieldErrors guards the behavior. -->
	  <NoWarn>$(NoWarn);ASP0029</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Validation" Version="10.0.12" />
  </ItemGroup>

</Project>
